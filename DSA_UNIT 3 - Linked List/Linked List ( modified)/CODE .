
#include <iostream>
#include <string>
#include <limits>
using namespace std;

struct Contact {
    string name;
    string phone;
    string address;
    Contact* next;
};

Contact* head = NULL;

// Check whether a phone number already exists
bool phoneExists(string phone) {
    Contact* temp = head;

    while (temp != NULL) {
        if (temp->phone == phone)
            return true;
        temp = temp->next;
    }
    return false;
}

// Add a new contact
void addContact() {
    Contact* newContact = new Contact;

    cout << "Enter Name: ";
    getline(cin >> ws, newContact->name);

    cout << "Enter Phone Number: ";
    getline(cin, newContact->phone);

    if (phoneExists(newContact->phone)) {
        cout << "Phone number already exists!\n";
        delete newContact;
        return;
    }

    cout << "Enter Address: ";
    getline(cin, newContact->address);

    newContact->next = NULL;

    if (head == NULL) {
        head = newContact;
    } else {
        Contact* temp = head;
        while (temp->next != NULL)
            temp = temp->next;

        temp->next = newContact;
    }

    cout << "Contact added successfully!\n";
}

// Display all contacts
void displayContacts() {
    if (head == NULL) {
        cout << "No contacts available.\n";
        return;
    }

    Contact* temp = head;
    int count = 1;

    while (temp != NULL) {
        cout << "\nContact " << count++;
        cout << "\nName: " << temp->name;
        cout << "\nPhone: " << temp->phone;
        cout << "\nAddress: " << temp->address;
        cout << "\n----------------------\n";

        temp = temp->next;
    }
}

// Search contact by name or phone number
void searchContact() {
    int option;
    cout << "1. Search by Name\n";
    cout << "2. Search by Phone\n";
    cout << "Enter option: ";

    if (!(cin >> option)) {
        cin.clear();
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
        cout << "Invalid input.\n";
        return;
    }

    string key;
    cout << "Enter search value: ";
    getline(cin >> ws, key);

    Contact* temp = head;

    while (temp != NULL) {
        if ((option == 1 && temp->name == key) ||
            (option == 2 && temp->phone == key)) {
            cout << "\nContact Found!\n";
            cout << "Name: " << temp->name << "\n";
            cout << "Phone: " << temp->phone << "\n";
            cout << "Address: " << temp->address << "\n";
            return;
        }
        temp = temp->next;
    }

    cout << "Contact not found.\n";
}

// Update contact details
void updateContact() {
    string name;

    cout << "Enter name of contact to update: ";
    getline(cin >> ws, name);

    Contact* temp = head;

    while (temp != NULL && temp->name != name)
        temp = temp->next;

    if (temp == NULL) {
        cout << "Contact not found.\n";
        return;
    }

    string newPhone, newAddress;

    cout << "Enter new phone number: ";
    getline(cin, newPhone);

    if (newPhone != temp->phone && phoneExists(newPhone)) {
        cout << "Phone number already belongs to another contact!\n";
        return;
    }

    cout << "Enter new address: ";
    getline(cin, newAddress);

    temp->phone = newPhone;
    temp->address = newAddress;

    cout << "Contact updated successfully!\n";
}

// Delete contact by name
void deleteContact() {
    string name;

    cout << "Enter name to delete: ";
    getline(cin >> ws, name);

    Contact* temp = head;
    Contact* prev = NULL;

    while (temp != NULL && temp->name != name) {
        prev = temp;
        temp = temp->next;
    }

    if (temp == NULL) {
        cout << "Contact not found.\n";
        return;
    }

    if (prev == NULL)
        head = temp->next;
    else
        prev->next = temp->next;

    delete temp;
    cout << "Contact deleted successfully!\n";
}

// Count total contacts
void countContacts() {
    int count = 0;
    Contact* temp = head;

    while (temp != NULL) {
        count++;
        temp = temp->next;
    }

    cout << "Total contacts: " << count << "\n";
}

// Free allocated memory
void freeMemory() {
    while (head != NULL) {
        Contact* temp = head;
        head = head->next;
        delete temp;
    }
}

int main() {
    int choice;

    do {
        cout << "\n=== CONTACT MANAGEMENT SYSTEM ===\n";
        cout << "1. Add Contact\n";
        cout << "2. Display Contacts\n";
        cout << "3. Search Contact\n";
        cout << "4. Update Contact\n";
        cout << "5. Delete Contact\n";
        cout << "6. Count Contacts\n";
        cout << "7. Exit\n";
        cout << "Enter your choice: ";

        if (!(cin >> choice)) {
            cin.clear();
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
            cout << "Invalid input. Enter a number.\n";
            continue;
        }

        switch (choice) {
            case 1: addContact(); break;
            case 2: displayContacts(); break;
            case 3: searchContact(); break;
            case 4: updateContact(); break;
            case 5: deleteContact(); break;
            case 6: countContacts(); break;
            case 7:
                freeMemory();
                cout << "Exiting program...\n";
                break;
            default:
                cout << "Invalid choice. Try again.\n";
        }

    } while (choice != 7);

    return 0;
}

