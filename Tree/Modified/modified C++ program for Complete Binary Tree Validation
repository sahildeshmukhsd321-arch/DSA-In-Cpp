
#include <iostream>
#include <queue>
#include <vector>
#include <string>
using namespace std;

struct Node
{
    int data;
    Node *left, *right;

    Node(int value)
    {
        data = value;
        left = right = NULL;
    }
};

// Queue-based completeness check
bool isComplete(Node *root)
{
    if (root == NULL)
        return true;

    queue<Node*> q;
    q.push(root);
    bool gap = false;

    while (!q.empty())
    {
        Node *temp = q.front();
        q.pop();

        if (temp->left != NULL)
        {
            if (gap)
            {
                cout << "First violation: left child of node "
                     << temp->data << endl;
                return false;
            }
            q.push(temp->left);
        }
        else
        {
            gap = true;
        }

        if (temp->right != NULL)
        {
            if (gap)
            {
                cout << "First violation: right child of node "
                     << temp->data << endl;
                return false;
            }
            q.push(temp->right);
        }
        else
        {
            gap = true;
        }
    }

    return true;
}

// Array-index method using a queue
// This avoids allocating a huge array for sparse trees.
bool arrayCheck(Node *root)
{
    if (root == NULL)
        return true;

    queue<pair<Node*, long long> > q;
    q.push(make_pair(root, 0));

    long long expected = 0;

    while (!q.empty())
    {
        Node *temp = q.front().first;
        long long index = q.front().second;
        q.pop();

        if (index != expected)
        {
            cout << "First violation: missing array index "
                 << expected << endl;
            return false;
        }

        expected++;

        if (temp->left != NULL)
            q.push(make_pair(temp->left, 2 * index + 1));

        if (temp->right != NULL)
            q.push(make_pair(temp->right, 2 * index + 2));
    }

    return true;
}

// Test different binary trees
void testTree(int choice)
{
    Node *root = new Node(1);

    if (choice == 1)
    {
        // Complete binary tree
        root->left = new Node(2);
        root->right = new Node(3);
        root->left->left = new Node(4);
        root->left->right = new Node(5);
    }
    else if (choice == 2)
    {
        // Missing left child of node 2, but right child exists
        root->left = new Node(2);
        root->right = new Node(3);
        root->left->right = new Node(5);
    }
    else if (choice == 3)
    {
        // Missing position at a lower level
        root->left = new Node(2);
        root->right = new Node(3);
        root->left->left = new Node(4);
        root->right->right = new Node(7);
    }

    cout << "\n--- Test Tree " << choice << " ---" << endl;

    cout << "Queue-based check: ";
    bool queueResult = isComplete(root);

    if (queueResult)
        cout << "Complete" << endl;
    else
        cout << "Not complete" << endl;

    cout << "Array-index check: ";
    bool indexResult = arrayCheck(root);

    if (indexResult)
        cout << "Complete" << endl;
    else
        cout << "Not complete" << endl;

    cout << "Comparison: ";
    if (queueResult == indexResult)
        cout << "Both methods agree." << endl;
    else
        cout << "Results differ." << endl;
}

int main()
{
    cout << "COMPLETE BINARY TREE VALIDATION" << endl;

    testTree(1);
    testTree(2);
    testTree(3);

    return 0;
}

